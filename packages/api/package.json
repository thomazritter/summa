{
  "name": "@summarizer/api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "experiment:pregenerate": "tsx src/scripts/pregenerate.ts",
    "experiment:metrics": "tsx src/scripts/run-metrics.ts",
    "experiment:compute-metrics": "tsx src/scripts/compute-metrics.ts",
    "db:migrate:feedback": "tsx src/db/migrate-embedded-feedback.ts",
    "db:migrate:auth": "tsx src/db/migrate-auth.ts"
  },
  "dependencies": {
    "@summarizer/shared": "1.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "resend": "^6.4.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.16",
    "@types/pg": "^8.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
